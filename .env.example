# Local-only development values. Do not reuse these credentials outside this checkout.
COMPOSE_PROJECT_NAME=observatorio-secop

# PostgreSQL base service (required)
POSTGRES_IMAGE=postgres:16.4-alpine
POSTGRES_USER=secop_admin
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_DB=secop
POSTGRES_PORT=5432
AIRFLOW_DB=airflow
MLFLOW_DB=mlflow

# Optional Airflow profile
AIRFLOW_IMAGE=apache/airflow:2.10.5-python3.12
AIRFLOW_UID=50000
AIRFLOW_PORT=8080

# Optional MLflow profile
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:v3.4.0
MLFLOW_PORT=5000

# Maximum seconds for local service health checks
SERVICE_HEALTH_TIMEOUT=300

# Optional Socrata application token. Leave empty for bounded public requests.
SOCRATA_APP_TOKEN=
