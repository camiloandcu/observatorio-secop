        "partitions": [
          {
            "name": "mart_contract_detail",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Source = ReadPublication(PublicationDescriptor, \"mart_contract_detail\", PublicationServer, PublicationDatabase), Typed = Table.TransformColumns(Source, {{\"signing_date\", each if _ = null then null else if Value.Is(_, type datetimezone) then DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(_,0)) else DateTime.From(_), type nullable datetime}, {\"start_date\", each if _ = null then null else if Value.Is(_, type datetimezone) then DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(_,0)) else DateTime.From(_), type nullable datetime}, {\"end_date\", each if _ = null then null else if Value.Is(_, type datetimezone) then DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(_,0)) else DateTime.From(_), type nullable datetime}, {\"signing_month\", each if _ = null then null else if Value.Is(_, type datetimezone) then DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(_,0)) else DateTime.From(_), type nullable datetime}, {\"contract_value_cop\", each if _ = null then null else Currency.From(_, \"en-US\"), Currency.Type}, {\"source_updated_at\", each if _ = null then null else if Value.Is(_, type datetimezone) then DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(_,0)) else DateTime.From(_), type nullable datetime}, {\"acquisition_observed_at_utc\", each if _ = null then null else if Value.Is(_, type datetimezone) then DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(_,0)) else DateTime.From(_), type nullable datetime}, {\"pipeline_completed_at_utc\", each if _ = null then null else if Value.Is(_, type datetimezone) then DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(_,0)) else DateTime.From(_), type nullable datetime}, {\"observation_condition\", each if _ = null then null else if Value.Is(_, type text) then _ else Text.FromBinary(Json.FromValue(_)), type nullable text}, {\"attributable_rejection_evidence\", each if _ = null then null else if Value.Is(_, type text) then _ else Text.FromBinary(Json.FromValue(_)), type nullable text}, {\"coverage_metadata\", each if _ = null then null else if Value.Is(_, type text) then _ else Text.FromBinary(Json.FromValue(_)), type nullable text}, {\"candidate_built_at_utc\", each if _ = null then null else if Value.Is(_, type datetimezone) then DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(_,0)) else DateTime.From(_), type nullable datetime}}) in Typed"
            }
          }
        ]
      },
